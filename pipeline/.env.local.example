# Environment variables for local pipeline runs.
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
#   cp .env.local.example .env.local
#
# In CI these come from GitHub Actions repository secrets, never from a file.

# Ticketmaster Discovery API "Consumer Key" from developer.ticketmaster.com.
# Only the Ticketmaster source reads this. Calagator needs no credentials.
TICKETMASTER_API_KEY=
