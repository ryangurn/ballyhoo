# App Store Connect API keys. The .p8 is downloadable exactly once and cannot
# be re-issued from the same key, so a leak means revoking and re-keying. Kept
# outside the repo entirely — this is the second line of defence, not the first.
*.p8
fastlane/.env
fastlane/.env.*

